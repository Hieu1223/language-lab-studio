```gitignore
# Dependencies
node_modules/

# Logs and temp files
*.log
*.tmp

# Environment variables
.env
.env.local
.env.*

# Editors
.vscode/
.idea/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
.env

# Build outputs
dist/
build/
target/
*.out
*.exe
*.dll
*.so
*.a
*.obj

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo

# Coverage
coverage/
htmlcov/
.coverage

# Cache
.mypy_cache/
.pytest_cache/
.gradle/
```