{
  "name": "ArisuGo — Học tiếng Nhật cùng Arisu",
  "short_name": "ArisuGo",
  "description": "Học tiếng Nhật vui vẻ qua YouTube, manga và flashcard cùng cô gia sư Arisu.",
  "start_url": "/youtube",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#22c55e",
  "lang": "vi",
  "icons": [
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
